@page
@model IndexModel
@{
    ViewData["Title"] = "Executive dashboard";
}

<div data-dashboard-region
     data-dashboard-url="@Url.Page("/Index", "Metrics", new { week = Model.SelectedWeekValue })"
     aria-live="polite"
     aria-busy="false">
    <section class="dashboard-section metrics-section" aria-labelledby="metrics-heading">
        <div class="dashboard-section__heading">
            <h1 id="metrics-heading">Executive metrics</h1>
            <p>Loading Work IQ signals for @Model.PeriodLabel.</p>
        </div>
        <p class="dashboard-loading-status" role="status">Loading dashboard metrics…</p>
        <ul class="metric-grid" role="list" aria-hidden="true">
            @for (var index = 0; index < 6; index++)
            {
                <li class="metric-grid__item">
                    <article class="metric-card metric-card--loading">
                        <span class="visually-hidden">Loading metric</span>
                    </article>
                </li>
            }
        </ul>
    </section>
</div>

<noscript>
    <style>
        [data-dashboard-region] {
            display: none;
        }
    </style>
    <aside class="dashboard-alert" role="alert">
        <strong>JavaScript is required to load Work IQ metrics.</strong>
        <span>Enable JavaScript and reload the page.</span>
    </aside>
</noscript>
